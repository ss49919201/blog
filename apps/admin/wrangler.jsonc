{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "blog-admin",
	"main": "src/index.tsx",
	"compatibility_date": "2026-11-17",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// 認証はアプリでは行わず Cloudflare Access に任せる。
	// Access を掛けていない経路から到達できないよう、workers.dev とプレビュー URL は無効にする。
	"workers_dev": false,
	"preview_urls": false,
	// TODO: Access で保護するカスタムドメインを設定する
	// "routes": [{ "pattern": "admin.example.com", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog",
			// TODO: `wrangler d1 create blog` で出た ID に置き換える（app と同じ値）
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../../migrations"
		}
	]
}
