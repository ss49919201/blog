{
  "name": "admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/local.sql"
  },
  "dependencies": {
    "hono": "4.13.16",
    "neverthrow": "8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
